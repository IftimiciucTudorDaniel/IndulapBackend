server {
    server_name api.indulap.ro;

        location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection keep-alive;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 300;
        proxy_send_timeout 300;

        proxy_buffer_size          128k;
        proxy_buffers              16 128k;
        proxy_busy_buffers_size    256k;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/api.indulap.ro/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/api.indulap.ro/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = api.indulap.ro) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name api.indulap.ro;
    return 404; # managed by Certbot


}
server {
    if ($host = api.indulap.ro) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name api.indulap.ro;

    listen 80;
    listen [::]:80;
    return 404; # managed by Certbot


}